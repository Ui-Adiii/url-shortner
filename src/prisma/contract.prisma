// use prisma-8

model User {
  id        String   @id @onCreate(uuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt temporal.UpdatedAt?
  shortUrls ShortUrl[]?
}

model ShortUrl {
  id        Uuid     @id @onCreate(uuid())
  fullUrl  String
  short String   @unique
  clicks    Int?      @default(0)
  createdAt DateTime? @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  @@index([short])
}